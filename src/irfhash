def cmd_list(vault: IrfHashVault, args: List[str]):
    cat = vault.load_catalog()
    conns = list(cat.get("connections", {}).values())
    if "--json" in args:
        print(json.dumps(conns, indent=2))
        return

    settings = vault.load_settings()
    custom_dom = settings.get("custom_domain", "irfhash.localhost")
    port = settings.get("dashboard_port", 8765)

    status_order = {"ACTIVE": 1, "CONFIGURED": 2, "UNVERIFIED": 3, "EXPIRED": 4}
    conns.sort(key=lambda c: (status_order.get(c.get("status", ""), 5), c.get("system", ""), c.get("name", "")))

    print("=" * 145)
    print(
        f"{'ID':<30} | {'EDITABLE NAME':<34} | {'SYS':<13} | {'ENV':<6} | {'STATUS':<10} | {'MASKED KEY':<20} | {'URL'}"
    )
    print("=" * 145)
    for c in conns:
        cid = c.get("id", "")[:30]
        name = c.get("name", "")[:34]
        sys_name = c.get("system", "")[:13]
        env = c.get("environment", "")[:6]
        st = c.get("status", "")[:10]
        masked = c.get("masked_preview", "")[:20]
        url = c.get("url", "")
        print(f"{cid:<30} | {name:<34} | {sys_name:<13} | {env:<6} | {st:<10} | {masked:<20} | {url}")
    print("=" * 145)
    active_cnt = sum(1 for c in conns if c.get("status") == "ACTIVE")
    exp_cnt = sum(1 for c in conns if c.get("status") == "EXPIRED")
    cfg_cnt = sum(1 for c in conns if c.get("status") == "CONFIGURED")
    print(
        f"Total: {len(conns)} connections ({active_cnt} ACTIVE, {cfg_cnt} CONFIGURED, {exp_cnt} EXPIRED) | "
        f"Dashboard: http://{custom_dom}:{port} (or http://127.0.0.1:{port})"
    )


def cmd_add(vault: IrfHashVault, args: List[str]):
    parser = argparse.ArgumentParser(prog="irfhash add")
    parser.add_argument("--id", required=True, help="Unique connection slug ID (e.g. slack-bot, jira-main)")
    parser.add_argument("--name", required=True, help="Editable friendly name")
    parser.add_argument("--system", default="custom", help="System category (slack, jira, github, notion, stripe, etc.)")
    parser.add_argument("--url", required=True, help="Base URL or endpoint")
    parser.add_argument("--env", default="TEST", help="Environment (TEST, UAT, DEV, PROD, PERSONAL)")
    parser.add_argument("--auth-type", default="Bearer", help="ApiKey, Bearer, Basic, CustomHeader, OAuth2Client")
    parser.add_argument("--header-name", default="Authorization", help="HTTP Header name")
    parser.add_argument("--header-prefix", default=None, help="HTTP Header prefix (e.g. 'ApiKey ', 'Bearer ')")
    parser.add_argument("--secret", default=None, help="Secret/API key (or pipe via stdin)")
    parser.add_argument("--notes", default="", help="Reference notes")
    parser.add_argument("--sanitize", action="store_true", help="Immediately redact this secret from AI chat logs")
    parsed = parser.parse_args(args)

    sec = parsed.secret
    if not sec and not sys.stdin.isatty():
        sec = sys.stdin.read().strip()

    prefix = parsed.header_prefix
    if prefix is None:
        if parsed.auth_type == "ApiKey":
            prefix = "ApiKey "
        elif parsed.auth_type == "Bearer":
            prefix = "Bearer "
        else:
            prefix = ""

    extra_headers = {}
    if parsed.system.lower() == "search-cluster":
        extra_headers["kbn-xsrf"] = "true"
    elif parsed.system.lower() == "diagram-api":
        extra_headers["X-Api-Version"] = "1"

    entry = vault.upsert_connection(
        conn_id=parsed.id,
        name=parsed.name,
        system=parsed.system,
        url=parsed.url,
        environment=parsed.env,
        auth_type=parsed.auth_type,
        secret_value=sec,
        header_name=parsed.header_name,
        header_prefix=prefix,
        extra_headers=extra_headers,
        notes=parsed.notes,
        actor="cli-add",
    )
    if sec:
        entry = vault.verify_connection(parsed.id, actor="cli-add")
    print(
        f"Added & encrypted '{entry['name']}' ({entry['id']}) | Status: {entry['status']} ({entry.get('status_detail', '')}) | Masked: {entry['masked_preview']}"
    )
    if parsed.sanitize:
        res = vault.sanitize_chats(dry_run=False, actor="cli-add-sanitize")
        print(f"Sanitized chat logs: redacted {res['total_redactions']} secret occurrences across {res['files_with_secrets']} files.")


def cmd_sanitize(vault: IrfHashVault, args: List[str]):
    dry = "--dry-run" in args or "-n" in args
    res = vault.sanitize_chats(dry_run=dry, actor="cli-sanitize")
    mode = "DRY RUN (Preview)" if dry else "SANITIZED & REDACTED"
    print(f"[{mode}] Scanned {res['files_scanned']} AI chat/session files.")
    print(f"Found & replaced {res['total_redactions']} raw secret occurrences across {res['files_with_secrets']} files.")
    if res["affected_connections"]:
        print("Redacted connections (replaced with AI-readable irfHASH pointers):")
        for cid, cnt in sorted(res["affected_connections"].items()):
            print(f"  - {cid}: {cnt} occurrences replaced")


def cmd_domain(vault: IrfHashVault, args: List[str]):
    if not args:
        s = vault.load_settings()
        dom = s.get("custom_domain", "irfhash.localhost")
        port = s.get("dashboard_port", 8765)
        print(f"Current custom local URL: http://{dom}:{port}")
        return
    dom = args[0]
    map_hosts = "--map-hosts" in args or "-m" in args
    res = vault.configure_custom_domain(dom, map_etc_hosts=map_hosts)
    print(f"Configured URL: {res['url']}")
    print(f"Zero-config .localhost URL: {res['fallback_localhost_url']}")
    print(f"Status: {res['message']}")


